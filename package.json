{
  "name": "seo-publish-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Publishes Markdown articles to WordPress through the REST API. Nothing reaches production without passing a content gate and a Playwright check on staging.",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "staging": "wp-playground-cli server --port 9400 --blueprint staging/blueprint.json --mount ./staging/mu-plugins:/wordpress/wp-content/mu-plugins",
    "production:local": "wp-playground-cli server --port 9401 --blueprint staging/blueprint.json --mount ./staging/mu-plugins:/wordpress/wp-content/mu-plugins",
    "check": "node src/cli.js check",
    "stage": "node src/cli.js stage",
    "verify": "node src/cli.js verify",
    "promote": "node src/cli.js promote"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.2.1",
    "node-html-parser": "^9.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@wp-playground/cli": "^3.1.65"
  }
}
