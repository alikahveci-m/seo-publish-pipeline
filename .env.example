# Staging is the throwaway WordPress started by `npm run staging`.
# Its password is created by staging/blueprint.json and protects nothing.
STAGING_WP_URL=http://127.0.0.1:9400
STAGING_WP_USER=admin
STAGING_WP_APP_PASSWORD=StagingOnlyNotASecret000

# Production: a real site. Create an application password in
# Users > Profile > Application Passwords and keep it out of git.
PRODUCTION_WP_URL=
PRODUCTION_WP_USER=
PRODUCTION_WP_APP_PASSWORD=
